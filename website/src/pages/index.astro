---
import PortalLayout from '../layouts/PortalLayout.astro';
import HomeOverview from '../components/HomeOverview.astro';
import MoleculeDiagram from '../components/MoleculeDiagram.astro';
import QramDiagram from '../components/QramDiagram.astro';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<PortalLayout>
  <HomeOverview />
  <section class="system-section" id="system" aria-labelledby="system-title"><div class="container">
    <div class="section-heading"><h2 id="system-title">系统介绍</h2><a class="text-link" href={`${base}docs/`}>了解模块与协作方式 <span aria-hidden="true">↗</span></a></div>
    <div class="capabilities">
      <div class="capability-card">
        <span class="capability-icon"><svg viewBox="0 0 40 40" aria-hidden="true"><rect x="4" y="4" width="12" height="10" rx="2"/><rect x="24" y="26" width="12" height="10" rx="2"/><rect x="4" y="26" width="12" height="10" rx="2"/><path d="M10 14v12m0-6h20v6"/></svg></span>
        <span class="capability-title" role="heading" aria-level="3">融合编程框架</span>
        <span class="capability-description">通用的组件与任务组织方式，按用户指定的资源执行。</span>
      </div>
      <div class="capability-card">
        <span class="capability-icon"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M5 4v31h31M12 25v5m8-12v12m8-21v21M10 17l9-8 8 4 9-8"/></svg></span>
        <span class="capability-title" role="heading" aria-level="3">性能模拟器</span>
        <span class="capability-description">根据任务图与硬件配置，估算执行耗时。</span>
      </div>
      <div class="capability-card">
        <span class="capability-icon"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="m12 10-9 10 9 10m16-20 9 10-9 10M23 6l-6 28"/></svg></span>
        <span class="capability-title" role="heading" aria-level="3">量子-经典混合程序</span>
        <span class="capability-description">在同一程序中组织经典计算与量子电路。</span>
      </div>
    </div>
    <figure class="interconnect-photo"><figcaption>量超融合系统概念图</figcaption><img src={`${base}images/quantum-hpc-interconnect.png`} width="1927" height="936" alt="量超互联：量子计算装置与经典计算服务器通过线缆连接" loading="lazy" /></figure>
  </div></section>
  <section class="section container" id="applications" aria-labelledby="applications-title">
    <div class="section-heading"><h2 id="applications-title">应用示例</h2></div>
    <div class="application-grid">
      <a class="application-card aimd-card" href={site.aimdUrl || `${base}examples/aimd/`}>
        <div class="application-copy"><h3>水分子 AIMD</h3><p>以分子动力学为例，展示量子与经典计算的协作。</p><span class="card-action">查看示例 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></span></div>
        <div class="application-art"><MoleculeDiagram id="home-water" compact /></div>
      </a>
      <a class="application-card qram-card" href={site.qramUrl || `${base}examples/qram/`}>
        <div class="application-copy"><h3>QRAM</h3><p>了解量子随机访问存储的寻址与读取。</p><span class="card-action">了解应用 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></span></div>
        <div class="application-art"><QramDiagram compact /></div>
      </a>
    </div>
  </section>
  <section class="container guide-callout"><div><h2>系统介绍与使用指南</h2><p>了解各模块的工作方式与协作流程，通过应用示例开始使用。</p></div><a class="button primary" href={`${base}docs/`}>阅读使用指南</a></section>
</PortalLayout>
<style>
  .capabilities{gap:28px}
  .capability-card{
    display:flex;flex-direction:column;align-items:flex-start;position:relative;
    width:100%;min-width:0;min-height:252px;padding:28px;
    border:1px solid #e5eaf1;border-radius:22px;text-align:left;
    background:linear-gradient(145deg,#fff,#f9fafc);color:var(--blue);cursor:default;
    box-shadow:0 4px 7px #18354f05,0 12px 30px #18354f0b;
    transition:transform .4s cubic-bezier(.22,1,.36,1),box-shadow .4s,background .35s,border-color .35s,color .3s;
  }
  .capability-icon{
    align-self:center;display:grid;place-items:center;flex-shrink:0;width:88px;height:88px;
    margin-bottom:20px;border:3px solid transparent;border-radius:50%;
    background:linear-gradient(#fff,#f6faff) padding-box,linear-gradient(145deg,#60d0f1,#3685de 58%,#6c5eea) border-box;
    box-shadow:0 5px 14px #3b87c21a;transition:transform .4s,box-shadow .4s;
  }
  .capability-icon svg{display:block;width:46px;height:46px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}
  .capability-title{font-size:24px;font-weight:600;line-height:1.4;letter-spacing:-.02em}
  .capability-description{font-size:16px;line-height:1.8;color:var(--body);margin:12px 0 0;transition:color .3s}
  @media(hover:hover){
    .capability-card:hover{
      color:#fff;background:linear-gradient(145deg,#102e50,#174a79);border-color:#4d9bd5;
      transform:translateY(-8px);box-shadow:0 8px 14px #123b6414,0 22px 42px #123b6430;
    }
    .capability-card:hover .capability-description{color:#e2ecf7}
    .capability-card:hover .capability-icon{color:var(--blue);transform:translateY(-3px) scale(1.04);box-shadow:0 8px 24px #061c4233}
  }
  @media(max-width:1000px){.capabilities{gap:20px}.capability-card{padding:26px 22px}.capability-title{font-size:21px}}
  @media(max-width:760px){.capabilities{gap:20px}.capability-card{min-height:232px;padding:24px}.capability-icon{width:80px;height:80px;margin-bottom:18px}.capability-icon svg{width:42px;height:42px}.capability-title{font-size:22px}}
  @media(prefers-reduced-motion:reduce){.capability-card,.capability-icon{transition:none}.capability-card:hover,.capability-card:hover .capability-icon{transform:none}}
  #system-title::before,#applications-title::before{display:none}
  .interconnect-photo{margin-top:44px;background:#fff;border:1px solid var(--line);border-radius:9px;overflow:hidden}
  .interconnect-photo figcaption{padding:24px 28px 0;font-size:32px;font-weight:600;line-height:1.4;color:#000;text-align:left}
  .interconnect-photo img{width:min(100%,960px);margin-inline:auto;padding-block:24px}
  @media(max-width:760px){.interconnect-photo{margin-top:32px}.interconnect-photo figcaption{padding:20px 20px 0;font-size:26px}}
</style>
