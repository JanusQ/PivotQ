  <script>
    import { mountAimdAnalysis } from '../../lib/aimd-analysis';
    document.querySelectorAll<HTMLElement>('[data-aimd-analysis]').forEach(mountAimdAnalysis);
    document.querySelectorAll<HTMLButtonElement>('[data-aimd-copy]').forEach(button => {
      if (!navigator.clipboard?.writeText) return;
      button.hidden = false;
      const feedback = button.querySelector<HTMLElement>('[data-copy-feedback]');
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.codeSource ?? '');
          if (feedback) feedback.textContent = '已复制';
        } catch {
          if (feedback) feedback.textContent = '复制失败';
        }
        window.setTimeout(() => { if (feedback) feedback.textContent = '复制代码'; }, 2200);
      });
    });
  </script>
