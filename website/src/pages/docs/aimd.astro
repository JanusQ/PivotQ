---
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { Content, frontmatter, getHeadings } from '../../content/guide/aimd.md';
import '../../styles/flow-docs.css';

const base = import.meta.env.BASE_URL;
const steps = getHeadings().filter(heading => heading.depth === 2);
---
<PortalLayout title="水分子动力学模拟工作台教程" page="docs" description={frontmatter.description}>
  <section class="flow-guide flow-guide-tutorial" aria-labelledby="tutorial-title">
    <header class="flow-guide-hero">
      <div class="container flow-guide-hero-inner">
        <div class="flow-guide-hero-copy">
          <h1 id="tutorial-title">水分子动力学模拟工作台教程</h1>
          <p class="flow-guide-intro">逐步了解工作台如何完成一次水分子计算，并分清目标硬件预测与 CPU 模拟结果。</p>
        </div>
        <div class="flow-guide-diagram" aria-hidden="true">
          <span class="flow-guide-diagram-line"></span>
          <span class="flow-guide-diagram-node flow-guide-diagram-node--first"><span class="flow-guide-diagram-number">01</span><strong>编译电路</strong></span>
          <span class="flow-guide-diagram-node flow-guide-diagram-node--second"><span class="flow-guide-diagram-number">02</span><strong>性能预测</strong></span>
          <span class="flow-guide-diagram-node flow-guide-diagram-node--third"><span class="flow-guide-diagram-number">03</span><strong>查看结果</strong></span>
        </div>
      </div>
    </header>

    <div class="container flow-guide-shell">
      <aside class="flow-guide-sidebar" aria-label="教程目录">
        <p class="flow-guide-sidebar-label">教程目录</p>
        <nav class="flow-guide-chapters" aria-label="教程章节">
          <a href={`${base}docs/`}><span class="flow-guide-chapter-number"><ArrowLeft size={15} /></span><span>文档</span></a>
          {steps.map((step, index) => (
            <a href={`#${step.slug}`}><span class="flow-guide-chapter-number">{String(index + 1).padStart(2, '0')}</span><span>{step.text.replace(/^\d+\.\s*/, '')}</span></a>
          ))}
        </nav>
      </aside>

      <div class="flow-guide-reading">
        <article class="flow-guide-content" aria-label="水分子动力学模拟工作台教程正文" data-pagefind-body>
          <Content />
        </article>
        <nav class="flow-guide-pager" aria-label="继续浏览">
          <a class="flow-guide-pager-link flow-guide-pager-link--prev" href={`${base}docs/`}><span class="flow-guide-pager-direction">返回文档</span><strong>文档</strong></a>
          <a class="flow-guide-pager-link flow-guide-pager-link--next" href={`${base}examples/aimd/`}><span class="flow-guide-pager-direction">继续查看 <ArrowUpRight size={13} /></span><strong>水分子动力学模拟教程数据</strong></a>
        </nav>
      </div>
    </div>
  </section>
</PortalLayout>
<script>
  document.querySelectorAll<HTMLImageElement>('.flow-guide-tutorial .flow-guide-content img').forEach(image => {
    const link = document.createElement('a');
    link.href = image.currentSrc || image.src;
    link.target = '_blank';
    link.rel = 'noopener';
    link.className = 'flow-guide-image-link';
    link.title = '点击查看大图（新窗口）';
    link.setAttribute('aria-label', `${image.alt}，在新窗口查看大图`);
    image.replaceWith(link);
    link.append(image);
  });

  const steps = Array.from(document.querySelectorAll<HTMLAnchorElement>('.flow-guide-tutorial .flow-guide-chapters a[href^="#"]'));
  const updateCurrentStep = () => {
    const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--site-header-height')) || 0;
    const activationLine = Math.max(headerHeight + 36, innerHeight / 3);
    let current = steps[0];
    for (const step of steps) {
      const heading = document.getElementById(decodeURIComponent(step.hash.slice(1)));
      if (heading && heading.getBoundingClientRect().top <= activationLine) current = step;
    }
    steps.forEach(step => {
      if (step === current) step.setAttribute('aria-current', 'location');
      else step.removeAttribute('aria-current');
    });
  };
  window.addEventListener('scroll', updateCurrentStep, { passive: true });
  window.addEventListener('hashchange', updateCurrentStep);
  updateCurrentStep();
</script>
