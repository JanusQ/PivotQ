---
import { Image } from 'astro:assets';
import { ArrowRight, BookOpen } from '@lucide/astro';
import labPhoto from '../assets/hero-lab.png';
const base = import.meta.env.BASE_URL;
---
<section class="flow-hero" aria-labelledby="home-title">
  <Image class="flow-hero-photo" src={labPhoto} alt="实验室中的量子计算装置、线缆与计算机柜" format="webp" quality={88} loading="eager" fetchpriority="high" />
  <div class="flow-hero-scrim" aria-hidden="true"></div>
  <div class="container flow-hero-content">
    <div class="flow-hero-copy">
    <h1 id="home-title">Pivot<span>Q</span></h1>
    <p class="flow-hero-title">统一描述 QPU、CPU、GPU 的计算任务，由 PivotQ 自动调度并执行。</p>
    <p class="flow-hero-description">PivotQ 帮助编程者构建和管理跨 CPU、GPU 与 QPU 的量子经典混合计算任务。</p>
    <div class="flow-hero-actions"><a class="flow-button flow-button-primary" href="#system">查看编程模型 <ArrowRight size={17} /></a><a class="flow-button flow-button-outline" href={`${base}docs/`}><BookOpen size={17} /> 文档</a></div>
    </div>
  </div>
</section>
