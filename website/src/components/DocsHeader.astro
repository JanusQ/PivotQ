---
import { PanelLeft } from '@lucide/astro';
import PortalHeader from './PortalHeader.astro';
const base = import.meta.env.BASE_URL;
const { hasSidebar } = Astro.locals.starlightRoute;
---
<div class="docs-header">
  <PortalHeader active="docs">
    <div slot="controls" class="docs-controls">
      {hasSidebar && <button class="docs-sidebar-toggle" popovertarget="starlight__sidebar" aria-label="打开文档目录" title="文档目录"><PanelLeft size={20} /></button>}
    </div>
  </PortalHeader>
</div>
<script define:vars={{ base }}>
  document.documentElement.dataset.theme = 'light';
  const legacy = {
    'guide-system-overview': 'architecture/',
    'system-overview': 'architecture/',
    'guide-使用指南': 'aimd/',
    '使用指南': 'aimd/',
    'guide-应用示例': 'examples/',
    '应用示例': 'examples/',
    'guide-应用教程': 'examples/',
    '应用教程': 'examples/',
    '1-选择应用并编译电路': 'aimd/#1-选择应用并编译电路',
    '2-分配计算硬件并发起性能预测': 'aimd/#2-分配计算硬件并发起性能预测',
    '3-查看性能预测结果': 'aimd/#3-查看性能预测结果',
    '4-提交任务并查看运行状态': 'aimd/#4-提交任务并查看运行状态',
    '5-查看水分子演化结果': 'aimd/#5-查看水分子演化结果',
  };
  function redirectLegacyHash() {
    if (location.pathname.replace(/\/$/, '') !== `${base}docs`.replace(/\/$/, '')) return;
    let hash = '';
    try { hash = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    if (!hash || document.getElementById(hash)) return;
    if (Object.hasOwn(legacy, hash)) {
      location.replace(`${base}docs/${legacy[hash]}`);
    } else if (hash.startsWith('guide-') && document.getElementById(hash.slice(6))) {
      location.replace(`${base}docs/#${encodeURIComponent(hash.slice(6))}`);
    }
  }
  // The Markdown headings must exist before resolving chapter aliases.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', redirectLegacyHash, { once: true });
  } else {
    redirectLegacyHash();
  }
  window.addEventListener('hashchange', redirectLegacyHash);
</script>
