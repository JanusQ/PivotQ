---
const base = import.meta.env.BASE_URL;
---
<section class="flow-architecture" id="system" aria-labelledby="architecture-title">
  <div class="container">
    <div class="flow-section-heading">
      <div>
        <h2 id="architecture-title"><span class="flow-section-number">01</span> <span class="flow-section-label">编程模型：</span>用 Python 写清 CPU、QPU、GPU 各自的任务和先后关系，提交后由 PivotQ 统一安排运行。</h2>
        <p class="flow-architecture-intro">以水分子动力学计算为例：CPU 读取 H-O-H 三个原子的坐标并准备输入；QPU 运行量子电路，CPU 将测量结果整理为量子特征；GPU 根据这些特征预测能量；CPU 再计算受力并更新原子位置。</p>
      </div>
    </div>
    <div class="flow-architecture-view" data-hardware-architecture data-active-hardware="qpu">
      <div class="flow-architecture-visual">
        <div class="flow-architecture-scene">
          <img class="flow-architecture-poster" src={`${base}images/hardware-render-poster.webp`} width="900" height="520" alt="CPU、QPU 与 GPU 互联的三维场景" loading="lazy" />
          <canvas data-hardware-canvas data-scene-ready="pending" tabindex="0" role="img" aria-label="可拖动旋转的互联架构：左侧 CPU 安排水分子模拟并更新原子位置，中间 QPU 运行量子电路，右侧 GPU 根据量子特征预测能量。箭头依次表示 CPU 到 QPU、QPU 到 GPU、GPU 回到 CPU。画面不可缩放"></canvas>
          <div class="flow-architecture-labels" aria-label="架构组件">
            <button type="button" class="flow-scene-label" data-hardware="cpu" aria-pressed="false" style="left:22%;top:28%" title="旋转至 CPU"><strong>CPU</strong><small>更新位置</small></button>
            <button type="button" class="flow-scene-label" data-hardware="qpu" aria-pressed="true" style="left:50%;top:20%" title="旋转至 QPU"><strong>QPU</strong><small>运行电路</small></button>
            <button type="button" class="flow-scene-label" data-hardware="gpu" aria-pressed="false" style="left:78%;top:31%" title="旋转至 GPU"><strong>GPU</strong><small>预测能量</small></button>
          </div>
        </div>
      </div>
      <aside class="flow-architecture-code" aria-label="CPU 与 QPU 程序片段">
        <div class="flow-code-block" data-code-block="cpu">
          <div class="flow-code-heading"><span data-code-title>CPU</span><small>读取原子坐标，计算受力并推进模拟</small></div>
          <pre><code><span class="flow-code-data-cpu">geometry_A</span> = atoms.get_positions()
prediction = potential.predict_geometry_energy_and_force(
    <span class="flow-code-data-cpu">geometry_A</span>[None, :, :]
)
<span class="flow-code-data-gpu">energies_eV</span> = prediction.energies_eV[0]
forces = prediction.forces_eV_per_A[0]
dynamics = VelocityVerlet(atoms, timestep=dt_fs * units.fs)
dynamics.run(steps)</code></pre>
          <p class="flow-code-explain"><code class="flow-code-data-cpu">geometry_A</code> 是三个原子的坐标，单位为 Å；<code class="flow-code-data-cpu">forces</code> 是它们受到的力。</p>
        </div>
        <div class="flow-code-block" data-code-block="qpu">
          <div class="flow-code-heading"><span data-code-title>QPU</span><small>运行电路，提取分子特征</small></div>
          <pre><code>qpu_api = FusionQPUCircuitFeatureExtractor(
    QPUCircuitService(framework, context)
)
quantum = qpu_api.extract_features(
    <span class="flow-code-data-cpu">quantum_request</span>
)
<span class="flow-code-data-qpu">features</span> = quantum.features</code></pre>
          <p class="flow-code-explain"><code class="flow-code-data-cpu">quantum_request</code> 包含水分子坐标；程序为每组坐标分别运行 Z、X 两种电路，并将测量结果整理为 14 个数值特征。</p>
        </div>
      </aside>
      <div class="flow-architecture-code-lower" role="group" aria-label="GPU 与作业提交程序片段">
        <div class="flow-code-block" data-code-block="gpu">
          <div class="flow-code-heading"><span data-code-title>GPU</span><small>根据量子结果预测能量</small></div>
          <pre><code>energy_request = ClassicalPredictRequest(
    request_id=request_id,
    sample_ids=sample_ids,
    <span class="flow-code-data-qpu">features</span>=<span class="flow-code-data-qpu">features</span>
)
<span class="flow-code-data-gpu">energies_eV</span> = classical_api.predict(
    energy_request
).energies_eV</code></pre>
          <p class="flow-code-explain"><code class="flow-code-data-qpu">features</code> 是从 QPU 测量结果中提取的数值特征；<code class="flow-code-data-gpu">energies_eV</code> 是模型预测的能量。</p>
        </div>
        <div class="flow-code-block flow-code-submit" data-code-block="submit">
          <div class="flow-code-heading"><span data-code-title>CPU 提交作业</span><small>一次提交，按步骤运行</small></div>
          <pre><code>spec = build_job_spec(
    submission_id=<span class="flow-code-string">"h2o-aimd-001"</span>,
    working_dir=work_dir,
    config_path=config_path,
    checkpoint_path=model_path,
    output_dir=output_dir,
    quantum_target=<span class="flow-code-data-qpu">"qpu"</span>,
    qos_helper_module=qpu_helper,
    qos_data_tree_target=qpu_data_tree,
)
job = RayJobClient(address).submit(spec)</code></pre>
          <p class="flow-code-explain">作业指定模型文件、运行配置和输出位置；提交后，由 CPU 协调 QPU 上的电路执行和 GPU 上的计算。</p>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  type Hardware = 'cpu' | 'qpu' | 'gpu';
  document.querySelectorAll<HTMLElement>('[data-hardware-architecture]').forEach(root => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-hardware-canvas]');
    const poster = root.querySelector<HTMLImageElement>('.flow-architecture-poster');
    if (!canvas) return;
    const labels = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hardware]'));
    const widths: Record<Hardware, number> = { cpu: 78, qpu: 90, gpu: 78 };
    let measuredCanvasWidth = 0;
    let scene: { setFocus: (kind: Hardware) => void; dispose: () => void } | null = null;
    const select = (kind: Hardware) => {
      root.dataset.activeHardware = kind;
      labels.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.hardware === kind)));
      scene?.setFocus(kind);
    };
    labels.forEach(label => label.addEventListener('click', () => select(label.dataset.hardware as Hardware)));
    import('../lib/hardware-scene').then(({ mountHardwareScene }) => {
      scene = mountHardwareScene(canvas, {
        initialFocus: root.dataset.activeHardware as Hardware,
        onLabels: positions => {
          const canvasWidth = canvas.clientWidth;
          if (canvasWidth !== measuredCanvasWidth) {
            labels.forEach(label => {
              const width = label.offsetWidth;
              if (width) widths[label.dataset.hardware as Hardware] = width;
            });
            measuredCanvasWidth = canvasWidth;
          }
          const visible = labels.map(label => {
            const kind = label.dataset.hardware as Hardware;
            return { label, kind, position: positions[kind], width: widths[kind] };
          }).filter(item => item.position.visible).sort((a, b) => a.position.x - b.position.x);
          const gap = canvasWidth < 500 ? 5 : 9;
          const centers: number[] = [];
          // Keep projected labels in view, then spread them across the canvas when a side view compresses their x positions.
          visible.forEach((item, index) => {
            const edge = item.width / 2 + 4;
            const projected = Math.max(edge, Math.min(canvasWidth - edge, item.position.x));
            const previous = visible[index - 1];
            centers.push(previous ? Math.max(projected, centers[index - 1] + (previous.width + item.width) / 2 + gap) : projected);
          });
          if (visible.length) {
            const last = visible.at(-1)!;
            const overflow = centers.at(-1)! + last.width / 2 + 4 - canvasWidth;
            if (overflow > 0) centers.forEach((center, index) => { centers[index] = center - overflow; });
            const underflow = 4 + visible[0].width / 2 - centers[0];
            if (underflow > 0) centers.forEach((center, index) => { centers[index] = center + underflow; });
          }
          visible.forEach((item, index) => { item.label.style.left = `${centers[index]}px`; });
          labels.forEach(label => {
            const position = positions[label.dataset.hardware as Hardware];
            label.style.top = `${position.y}px`;
            label.hidden = !position.visible;
          });
        },
        onReady: () => {
          root.classList.add('flow-architecture-ready');
          poster?.setAttribute('aria-hidden', 'true');
        },
      });
      if (!scene) root.classList.add('flow-architecture-failed');
    }).catch(error => {
      canvas.dataset.sceneReady = 'failed';
      root.classList.add('flow-architecture-failed');
      console.error('Hardware architecture could not load', error);
    });
    window.addEventListener('pagehide', event => { if (!event.persisted) scene?.dispose(); });
    window.addEventListener('pageshow', event => {
      if (event.persisted) scene?.setFocus(root.dataset.activeHardware as Hardware);
    });
  });
</script>
