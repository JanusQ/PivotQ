---
interface Props { href: string; placeholder?: boolean; }
const { href, placeholder = false } = Astro.props;
const description = placeholder ? '项目代码待开源，当前链接为 Qiskit 教程仓库' : '查看项目的 GitHub 仓库';
---
<a class="github-link" href={href} target="_blank" rel="noopener noreferrer" title={description} aria-label={`GitHub：${description}（在新标签页打开）`}>
  <svg class="github-symbol" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.438 9.8 8.205 11.385.6.11.82-.26.82-.577 0-.285-.01-1.04-.015-2.04-3.338.725-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.76-1.605-2.665-.3-5.467-1.333-5.467-5.93 0-1.31.468-2.38 1.235-3.22-.123-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23A11.5 11.5 0 0 1 12 6.3c1.02.005 2.047.138 3.007.405 2.29-1.552 3.297-1.23 3.297-1.23.654 1.652.242 2.873.12 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.625-5.48 5.922.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 22.296 24 17.8 24 12.5 24 5.87 18.627.5 12 .5Z" /></svg>
  <span>GitHub</span>
  <svg class="github-external" width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 12 4M5 4h7v7" /></svg>
</a>
<style>
  .github-link{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
  .github-symbol{flex-shrink:0}.github-external{opacity:.75;flex-shrink:0}
  @media(min-width:761px) and (max-width:960px){:global(.desktop-nav){gap:18px;font-size:14px}:global(.site-header .brand){font-size:18px;gap:8px}}
</style>
