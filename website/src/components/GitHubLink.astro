---
interface Props { href: string; placeholder?: boolean; }
const { href, placeholder = false } = Astro.props;
const description = placeholder ? '项目代码待开源，当前链接为 Qiskit 示例仓库' : '查看项目的 GitHub 仓库';
---
<a class="github-link" href={href} target="_blank" rel="noopener noreferrer" title={description} aria-label={`GitHub：${description}（在新标签页打开）`}>
  <svg class="github-symbol" width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
  <span>GitHub</span>
  <svg class="github-external" width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 12 4M5 4h7v7" /></svg>
</a>
<style>
  .github-link{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;color:inherit;font:inherit;text-decoration:none}
  .github-symbol{flex-shrink:0}.github-external{opacity:.75;flex-shrink:0}
  @media(min-width:761px) and (max-width:960px){:global(.desktop-nav){gap:18px;font-size:14px}:global(.site-header .brand){font-size:18px;gap:8px}}
</style>
