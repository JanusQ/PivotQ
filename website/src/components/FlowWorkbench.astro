---
import { ChevronLeft, ChevronRight, Clock3, Cpu, ListChecks, Orbit, ScanLine, Server } from '@lucide/astro';
import '../styles/flow-workbench.css';
const reportFields = ['各任务运行时间', '执行设备/计算节点', '指令执行顺序'];
---
<div class="flow-workspace" data-flow-workspace>
  <p class="flow-workspace-description" id="flow-workspace-description">为各计算步骤选择 CPU、GPU 或 QPU，并设置任务依赖。随后可在已连接的设备上运行，或使用离散事件仿真器估算性能。报告列出各任务的耗时、执行设备和指令顺序。性能模型的工作量按所用模型注明单位，例如浮点运算次数（FLOP）或采样次数（shots），不表示算法复杂度。</p>
  <div id="flow-workspace-panel" class="flow-workspace-canvas" tabindex="0" role="region" aria-label="编程仿真工作流" aria-describedby="flow-workspace-description">
    <div class="flow-workspace-track">
      <div class="flow-node flow-node-core flow-node-source">
        <span class="flow-node-port flow-node-port-right" aria-hidden="true"></span>
        <span class="flow-node-step">01 / 程序</span>
        <div class="flow-node-name"><ScanLine size={20} aria-hidden="true" /><strong>量子-经典<br />混合程序</strong></div>
        <p>用代码描述计算步骤与参数</p>
      </div>
      <div class="flow-edge flow-edge-program" aria-hidden="true"></div>
      <div class="flow-node flow-node-core flow-node-resources">
        <span class="flow-node-port flow-node-port-left" aria-hidden="true"></span><span class="flow-node-port flow-node-port-right" aria-hidden="true"></span>
        <span class="flow-node-step">02 / 设备</span>
        <div class="flow-node-name"><Cpu size={20} aria-hidden="true" /><strong>选择设备</strong></div>
        <p>为计算步骤指定目标设备</p>
        <div class="flow-resource-tags"><span data-resource="cpu">CPU</span><span data-resource="gpu">GPU</span><span data-resource="qpu">QPU</span></div>
      </div>
      <div class="flow-edge flow-edge-resources" aria-hidden="true"></div>
      <div class="flow-node flow-node-core flow-node-emphasis flow-node-compose">
        <span class="flow-node-port flow-node-port-left" aria-hidden="true"></span><span class="flow-node-port flow-node-port-right" aria-hidden="true"></span>
        <span class="flow-node-step">03 / 编排</span>
        <div class="flow-node-name"><Orbit size={20} aria-hidden="true" /><strong>任务编排</strong></div>
        <p>编译量子电路，确定各任务的先后关系。</p>
      </div>
      <div class="flow-fork" aria-hidden="true"><span class="flow-fork-arm flow-fork-arm-top"></span><span class="flow-fork-arm flow-fork-arm-bottom"></span></div>
      <div class="flow-node flow-node-emphasis flow-node-branch" data-flow-branch="hardware">
        <span class="flow-node-port flow-node-port-left" aria-hidden="true"></span><span class="flow-node-port flow-node-port-right" aria-hidden="true"></span>
        <span class="flow-node-step">04A / 实际执行</span>
        <div class="flow-node-name"><Server size={20} aria-hidden="true" /><strong>真机运行</strong></div>
        <p>在已连接的目标设备上执行任务</p>
      </div>
      <div class="flow-node flow-node-emphasis flow-node-branch" data-flow-branch="simulation">
        <span class="flow-node-port flow-node-port-left" aria-hidden="true"></span><span class="flow-node-port flow-node-port-right" aria-hidden="true"></span>
        <span class="flow-node-step">04B / 性能仿真</span>
        <div class="flow-node-name"><Clock3 size={20} aria-hidden="true" /><strong>离散事件<br />仿真器</strong></div>
        <p>根据任务工作量和设备模型，估算任务的执行时间与顺序。</p>
      </div>
      <div class="flow-merge" aria-hidden="true"><span class="flow-merge-arm flow-merge-arm-top"></span><span class="flow-merge-arm flow-merge-arm-bottom"></span><span class="flow-merge-tip"></span></div>
      <div class="flow-node flow-node-emphasis flow-node-report" data-flow-report="shared">
        <span class="flow-node-port flow-node-port-left" aria-hidden="true"></span>
        <span class="flow-node-step">05 / 报告</span>
        <div class="flow-node-name"><ListChecks size={20} aria-hidden="true" /><strong>真机/仿真性能报告</strong></div>
        <ul class="flow-report-fields" aria-label="真机/仿真性能报告内容">
          {reportFields.map(field => <li>{field}</li>)}
        </ul>
      </div>
    </div>
  </div>
  <p class="flow-workspace-hint">左右滑动或点击箭头，查看完整流程。</p>
  <div class="flow-workspace-rail-nav" aria-label="工作流节点导航">
    <button type="button" data-flow-prev aria-controls="flow-workspace-panel" aria-label="上一个工作流节点" title="上一个工作流节点" disabled><ChevronLeft size={17} /></button>
    <button type="button" data-flow-next aria-controls="flow-workspace-panel" aria-label="下一个工作流节点" title="下一个工作流节点"><ChevronRight size={17} /></button>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-flow-workspace]').forEach(root => {
    const panel = root.querySelector<HTMLElement>('#flow-workspace-panel');
    const nodes = Array.from(panel?.querySelectorAll<HTMLElement>('.flow-node') ?? []);
    const previousNode = root.querySelector<HTMLButtonElement>('[data-flow-prev]');
    const nextNode = root.querySelector<HTMLButtonElement>('[data-flow-next]');
    // Reflect the scroll region's actual limits after layout and scroll events;
    // hide the arrows when all columns fit, without changing diagram content.
    const updateNodeButtons = () => {
      if (!panel || !previousNode || !nextNode) return;
      const lastScroll = Math.max(0, panel.scrollWidth - panel.clientWidth);
      root.dataset.flowOverflow = String(lastScroll > 1);
      previousNode.disabled = panel.scrollLeft <= 1;
      nextNode.disabled = panel.scrollLeft >= lastScroll - 1;
    };
    // Advance by visual columns rather than DOM order: the two execution paths
    // share x coordinates, and the last stop is clamped so the shared report fits.
    const moveToNode = (direction: -1 | 1) => {
      if (!panel || !nodes.length) return;
      const lastScroll = Math.max(0, panel.scrollWidth - panel.clientWidth);
      const starts = [...new Set([0, ...nodes.map(node => Math.min(lastScroll, node.offsetLeft - nodes[0].offsetLeft)), lastScroll])].sort((a, b) => a - b);
      const target = direction === 1
        ? starts.find(start => start > panel.scrollLeft + 1)
        : starts.findLast(start => start < panel.scrollLeft - 1);
      if (target === undefined) return;
      panel.scrollTo({ left: target, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    previousNode?.addEventListener('click', () => moveToNode(-1));
    nextNode?.addEventListener('click', () => moveToNode(1));
    panel?.addEventListener('scroll', updateNodeButtons, { passive: true });
    window.addEventListener('resize', updateNodeButtons);
    if (panel) new ResizeObserver(updateNodeButtons).observe(panel);
    updateNodeButtons();
  });
</script>
