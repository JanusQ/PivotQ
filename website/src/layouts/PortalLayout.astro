---
import { ArrowUpRight } from '@lucide/astro';
import PortalHeader from '../components/PortalHeader.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/flow-global.css';

interface Props { title?: string; description?: string; page?: string; }
const { title, description = site.description, page = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const active = page === 'docs' ? 'docs' : page === 'aimd' || page === 'qram' ? 'applications' : 'home';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {page === '404' && <meta name="robots" content="noindex" />}
    {Astro.site && page !== '404' && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title ? `${title} · ${site.name}` : `${site.name} · 量超智融合系统`}</title>
  </head>
  <body class="flow-site" data-page={page}>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="site-header flow-header">
      <PortalHeader active={active} />
    </header>
    <main id="main"><slot /></main>
    <footer class="flow-footer">
      <div class="container flow-footer-main">
        <div class="flow-footer-intro"><a class="flow-footer-brand" href={base}>PivotQ</a><p>构建和管理跨 CPU、GPU 与 QPU 的量子经典混合计算任务。</p><span class="flow-footer-copyright">© {new Date().getFullYear()} PivotQ</span></div>
        <nav aria-label="页脚导航">
          <div class="flow-footer-group"><h2>编程模型</h2><a href={`${base}#system`}>计算任务</a><a href={`${base}#workflow`}>任务编排与性能分析</a></div>
          <div class="flow-footer-group"><h2>教程</h2><a href={`${base}examples/aimd/`}>水分子动力学模拟</a><a href={`${base}examples/qram/`}>量子随机存取存储器</a></div>
          <div class="flow-footer-group"><h2><a href={`${base}docs/`}>文档</a></h2><a href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub <ArrowUpRight size={14} /></a></div>
        </nav>
        <a class="flow-footer-zju" href="https://www.zju.edu.cn/" target="_blank" rel="noopener noreferrer" aria-label="浙江大学官网（新窗口）"><img src={`${base}images/zju-logo-white.svg`} width="184" height="51" alt="浙江大学" loading="lazy" /></a>
      </div>
    </footer>
  </body>
</html>
